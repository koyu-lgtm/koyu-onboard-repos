.controls-btn {
  padding: 6px 16px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: transparent;
  color: var(--text-primary);
  font-family: var(--font);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.15s;
}

.controls-btn:hover:not(:disabled) {
  border-color: var(--copper-dim);
  color: var(--copper);
}

.controls-btn:disabled {
  opacity: 0.35;
  cursor: default;
}

.controls-btn-primary {
  border-color: var(--copper);
  color: var(--copper-white);
  background: var(--copper-ember);
  box-shadow: 0 0 8px 0 rgba(232, 127, 36, 0.35);
}

.controls-btn-primary:hover:not(:disabled) {
  border-color: var(--copper-hot);
  color: var(--copper-hot);
  box-shadow: 0 0 12px 1px rgba(232, 127, 36, 0.55);
}

.controls-btn-reset-highlight {
  border-color: var(--copper);
  color: var(--copper-hot);
  background: var(--copper-ember);
  animation: controls-reset-pulse 1.6s ease-in-out infinite;
}

@keyframes controls-reset-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(232, 127, 36, 0); }
  50% { box-shadow: 0 0 10px 1px rgba(232, 127, 36, 0.45); }
}

/* ================================================================
   Rig controls — dense single-viewport eval surface (no scroll)
   ================================================================ */

.rig-page {
  display: grid;
  grid-template-rows: minmax(0, 1.4fr) minmax(0, 1fr) auto;
  gap: 10px;
  height: calc(100vh - 48px);
  padding: 10px 12px;
  overflow: hidden;
  box-sizing: border-box;
}

.rig-row {
  min-height: 0;
}

.rig-row-top {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
  gap: 10px;
}

.rig-cams {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  min-height: 0;
}

.rig-cam {
  position: relative;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--black-void);
  overflow: hidden;
  min-height: 0;
}

.rig-cam img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.rig-cam-label {
  position: absolute;
  left: 6px;
  bottom: 5px;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--text-secondary);
  background: rgba(5, 5, 5, 0.6);
  padding: 2px 6px;
  border-radius: 3px;
}

.rig-card {
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--black-raised);
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 0;
  overflow: hidden;
}

.rig-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rig-card-title {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--text-tertiary);
}

.rig-facts {
  display: flex;
  gap: 16px;
  font-size: 12px;
  color: var(--text-secondary);
  flex-wrap: wrap;
}

.rig-facts b {
  color: var(--text-primary);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.rig-task {
  margin: 0;
  font-size: 12px;
  color: var(--text-primary);
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.rig-note {
  margin: auto 0 0;
  font-size: 11px;
  color: var(--text-tertiary);
}

.rig-mono {
  margin: 0;
  font-family: ui-monospace, monospace;
  font-size: 11px;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rig-feed {
  border-top: 1px solid var(--line-faint);
  padding-top: 6px;
  display: flex;
  flex-direction: column;
  gap: 3px;
  overflow: hidden;
}

.rig-feed-row {
  margin: 0;
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-primary);
}

.rig-row-plot {
  min-height: 0;
  overflow: hidden;
}

.rig-row-plot .coupon-plot-card {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.rig-row-plot .coupon-plot-canvas {
  flex: 1;
  min-height: 0;
}

.rig-plot-empty {
  height: 100%;
  display: grid;
  place-items: center;
  border: 1px dashed var(--line-faint);
  border-radius: 6px;
  color: var(--text-tertiary);
  font-size: 12px;
}

.rig-provenance {
  display: flex;
  align-items: center;
  gap: 24px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--black-raised);
  padding: 7px 12px;
  overflow: hidden;
  white-space: nowrap;
}

.rig-prov-item {
  font-size: 12px;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
}

.rig-prov-item em {
  font-style: normal;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--text-tertiary);
  margin-right: 6px;
}

.rig-prov-item code {
  font-family: ui-monospace, monospace;
  font-size: 11px;
  color: var(--text-secondary);
}


